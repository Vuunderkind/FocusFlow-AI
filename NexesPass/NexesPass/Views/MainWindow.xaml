<Window x:Class="NexesPass.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexes Pass" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="600">

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16,0,0,16">
                <DockPanel>
                    <!-- Logo -->
                    <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                            MouseLeftButtonDown="DragWindow">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6C63FF" Offset="0"/>
                                        <GradientStop Color="#4ECDC4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="N" FontSize="18" FontWeight="Black"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nexes Pass" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- User card -->
                    <Border DockPanel.Dock="Top" Margin="12,0,12,16"
                            Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6C63FF" Offset="0"/>
                                        <GradientStop Color="#4ECDC4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="UserInitialsText" FontSize="15" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Premium" FontSize="11"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,0">
                        <TextBlock Text="МЕНЮ" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI" Margin="8,0,0,8"
                                   />

                        <Button x:Name="BtnDashboard" Click="NavClick" Tag="Dashboard"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="16" Width="22"/>
                                <TextBlock Text="Главная" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAccounts" Click="NavClick" Tag="Accounts"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏦" FontSize="16" Width="22"/>
                                <TextBlock Text="Счета" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCards" Click="NavClick" Tag="Cards"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="16" Width="22"/>
                                <TextBlock Text="Карты" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnTransfer" Click="NavClick" Tag="Transfer"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↔" FontSize="16" Width="22"/>
                                <TextBlock Text="Переводы" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnLoans" Click="NavClick" Tag="Loans"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Width="22"/>
                                <TextBlock Text="Кредиты" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAnalytics" Click="NavClick" Tag="Analytics"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Width="22"/>
                                <TextBlock Text="Аналитика" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom: Logout -->
                    <Border DockPanel.Dock="Bottom" Margin="12,0,12,20">
                        <Button Content="⇤  Выйти" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" Click="LogoutClick"
                                Foreground="{StaticResource DangerBrush}"/>
                    </Border>

                    <!-- Version -->
                    <TextBlock DockPanel.Dock="Bottom" Text="Nexes Pass v1.0.0"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Main content area -->
            <Grid Grid.Column="1">
                <!-- Top bar -->
                <Border Height="60" VerticalAlignment="Top" Padding="24,0"
                        MouseLeftButtonDown="DragWindow" Panel.ZIndex="10">
                    <Grid>
                        <TextBlock x:Name="PageTitle" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="8"
                                    Width="36" Height="36" Margin="0,0,8,0"
                                    Click="MinimizeClick">
                                <TextBlock Text="─" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="8"
                                    Width="36" Height="36"
                                    Click="CloseClick">
                                <TextBlock Text="✕" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Frame -->
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
                       Margin="0,60,0,0" Background="Transparent"/>
            </Grid>
        </Grid>
    </Border>
</Window>
