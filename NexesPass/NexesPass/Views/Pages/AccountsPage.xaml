<Page x:Class="NexesPass.Views.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Account list -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Счета" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <Button Content="+ Открыть" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" FontSize="12" HorizontalAlignment="Right"
                            Margin="Auto,0,0,0" Click="ShowCreateForm"/>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="AccItem" CornerRadius="12" Padding="14,12"
                                        Margin="0,4" Cursor="Hand" MouseLeftButtonDown="SelectAccount">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6C63FF" Offset="0"/>
                                                    <GradientStop Color="#4ECDC4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="🏦" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontFamily="Segoe UI">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2} {1}">
                                                        <Binding Path="Balance"/>
                                                        <Binding Path="Currency"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource AccTypeConv}}"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right: Account detail + transactions -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <!-- Account detail card -->
            <Border x:Name="AccountDetail" CornerRadius="16" Padding="28"
                    Margin="0,0,0,16" VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6C63FF" Offset="0"/>
                        <GradientStop Color="#4ECDC4" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="AccNameText" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI" Opacity="0.8"/>
                            <TextBlock x:Name="AccNumberText" FontSize="12"
                                       Foreground="White" FontFamily="Segoe UI" Opacity="0.6"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="+ Пополнить" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Padding="14,8" FontSize="13"
                                Background="White" Foreground="#6C63FF"
                                Click="ShowTopUp"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,20,0,20">
                        <TextBlock Text="Доступный баланс" FontSize="13"
                                   Foreground="White" FontFamily="Segoe UI" Opacity="0.7"/>
                        <TextBlock x:Name="AccBalanceText" FontSize="36" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Тип" FontSize="11" Foreground="White" Opacity="0.6" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="AccTypeText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Валюта" FontSize="11" Foreground="White" Opacity="0.6" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="AccCurrencyText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Открыт" FontSize="11" Foreground="White" Opacity="0.6" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="AccDateText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Top-up form -->
            <Border x:Name="TopUpForm" Background="{StaticResource CardBrush}" CornerRadius="16"
                    Padding="24" Margin="0,196,0,0" Visibility="Collapsed" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Пополнить счёт" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="СУММА ПОПОЛНЕНИЯ (₽)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="TopUpAmountBox" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" Text="10000"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Пополнить" Style="{StaticResource SuccessButton}"
                                Padding="20,10" Click="ExecuteTopUp"/>
                        <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                Padding="20,10" Margin="8,0,0,0" Click="HideTopUp"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transactions -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                    Padding="20" Margin="0,310,0,0">
                <StackPanel>
                    <TextBlock Text="История операций" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="TxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10"
                                                Background="{StaticResource InputBrush}">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TxIconConv}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="14"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Description}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontFamily="Segoe UI" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N2} {1}">
                                                    <Binding Path="Amount"/>
                                                    <Binding Path="Currency"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoTxText" Text="Операций по счёту пока нет"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,20" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Create account overlay -->
        <Border x:Name="CreateForm" Grid.ColumnSpan="2"
                Background="#CC000000" CornerRadius="16"
                Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16"
                    Padding="32" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Открыть новый счёт" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,24"/>

                    <TextBlock Text="НАЗВАНИЕ СЧЁТА" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="AccNameBox" Style="{StaticResource ModernTextBox}"
                             PlaceholderText="Мой счёт" Margin="0,0,0,16"/>

                    <TextBlock Text="ТИП СЧЁТА" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="AccTypeBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Текущий"/>
                        <ComboBoxItem Content="Накопительный"/>
                        <ComboBoxItem Content="Инвестиционный"/>
                    </ComboBox>

                    <TextBlock Text="ВАЛЮТА" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="AccCurrencyBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,24" SelectedIndex="0">
                        <ComboBoxItem Content="RUB — Рубль"/>
                        <ComboBoxItem Content="USD — Доллар"/>
                        <ComboBoxItem Content="EUR — Евро"/>
                        <ComboBoxItem Content="GBP — Фунт"/>
                    </ComboBox>

                    <Border x:Name="CreateErrBorder" Background="#2D1515" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="CreateErrText" Foreground="{StaticResource DangerBrush}"
                                   FontFamily="Segoe UI" FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Открыть счёт" Style="{StaticResource PrimaryButton}"
                                Padding="24,12" Click="ExecuteCreate"/>
                        <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                Padding="20,12" Margin="8,0,0,0" Click="HideCreateForm"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
