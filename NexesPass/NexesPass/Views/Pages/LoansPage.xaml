<Page x:Class="NexesPass.Views.Pages.LoansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Loans list + detail -->
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Кредиты" Style="{StaticResource SectionTitle}"/>
                <Button Content="+ Получить кредит" Style="{StaticResource PrimaryButton}"
                        Padding="14,8" FontSize="12" Margin="Auto,0,0,0"
                        Click="ShowApplyForm"/>
            </StackPanel>

            <!-- Active loans -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LoansList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                                    Padding="22,18" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource LoanTypeConv}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="Segoe UI" Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N0} ₽  •  {1}% годовых">
                                                        <Binding Path="PrincipalAmount"/>
                                                        <Binding Path="InterestRate"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" CornerRadius="6" Padding="10,4">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1A2D1A"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource LoanStatusConv}}"
                                                       FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                                       FontFamily="Segoe UI" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Progress -->
                                    <Grid Margin="0,14,0,10">
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="4" Height="6"/>
                                        <Border CornerRadius="4" Height="6" HorizontalAlignment="Left"
                                                Width="{Binding ProgressPercent, Converter={StaticResource ProgConv}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#6C63FF" Offset="0"/>
                                                    <GradientStop Color="#4ECDC4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="Segoe UI">
                                                <Run Text="Осталось: "/>
                                                <Run Text="{Binding RemainingBalance, StringFormat=N0}"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                                                <Run Text=" ₽"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontFamily="Segoe UI">
                                                <Run Text="След. платёж: "/>
                                                <Run Text="{Binding NextPaymentDate, StringFormat=dd.MM.yyyy}"
                                                     Foreground="{StaticResource WarningBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI">
                                            <Run Text="Платёж: "/>
                                            <Run Text="{Binding MonthlyPayment, StringFormat=N2}"/>
                                            <Run Text=" ₽/мес"/>
                                        </TextBlock>
                                        <Button Content="Внести платёж" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right" Padding="14,7" FontSize="12"
                                                Click="MakePayment"
                                                Tag="{Binding Id}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <Border x:Name="EmptyLoans" Background="{StaticResource CardBrush}" CornerRadius="16"
                    Padding="40" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Кредитов нет" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Оформите кредит по выгодной ставке"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="MsgBorder" Background="#2D1515" CornerRadius="8"
                    Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MsgText" Foreground="{StaticResource DangerBrush}"
                           FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Right: Calculator + Apply -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <!-- Loan calculator -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Кредитный калькулятор" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,20"/>

                    <TextBlock Text="ТИП КРЕДИТА" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="CalcTypeBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,14" SelectedIndex="0" SelectionChanged="RecalcCalc">
                        <ComboBoxItem Content="Потребительский — 14.9%"/>
                        <ComboBoxItem Content="Ипотека — 8.5%"/>
                        <ComboBoxItem Content="Автокредит — 11.5%"/>
                        <ComboBoxItem Content="Бизнес — 16.5%"/>
                    </ComboBox>

                    <TextBlock Text="СУММА (₽)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="CalcAmountBox" Style="{StaticResource ModernTextBox}"
                             Text="100000" Margin="0,0,0,14" TextChanged="RecalcCalc"/>

                    <TextBlock Text="СРОК (МЕСЯЦЕВ)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="CalcTermBox" Style="{StaticResource ModernTextBox}"
                             Text="24" Margin="0,0,0,20" TextChanged="RecalcCalc"/>

                    <Border Background="{StaticResource InputBrush}" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Ежемесячный платёж" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="CalcMonthly" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Сумма переплаты" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="CalcOverpay" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Итого выплат" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="CalcTotal" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Loan conditions -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Условия кредитования" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,16"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" LineHeight="22">
                        ✓ Мгновенное решение&#x0a;✓ Без справок и залогов до 500 000 ₽&#x0a;✓ Погашение без штрафов&#x0a;✓ Досрочное погашение бесплатно
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Apply form overlay -->
        <Border x:Name="ApplyForm" Grid.ColumnSpan="2"
                Background="#CC000000" CornerRadius="16"
                Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16"
                    Padding="32" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Оформить кредит" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,24"/>

                    <TextBlock Text="ТИП КРЕДИТА" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="ApplyTypeBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Потребительский — 14.9%"/>
                        <ComboBoxItem Content="Ипотека — 8.5%"/>
                        <ComboBoxItem Content="Автокредит — 11.5%"/>
                        <ComboBoxItem Content="Бизнес — 16.5%"/>
                    </ComboBox>

                    <TextBlock Text="СЧЁТ ЗАЧИСЛЕНИЯ" Style="{StaticResource LabelText}"/>
                    <ComboBox x:Name="ApplyAccountBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,16" DisplayMemberPath="Name"/>

                    <TextBlock Text="СУММА КРЕДИТА (₽)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="ApplyAmountBox" Style="{StaticResource ModernTextBox}"
                             Text="100000" Margin="0,0,0,16"/>

                    <TextBlock Text="СРОК (МЕСЯЦЕВ)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="ApplyTermBox" Style="{StaticResource ModernTextBox}"
                             Text="24" Margin="0,0,0,16"/>

                    <TextBlock Text="ЦЕЛЬ КРЕДИТА" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="ApplyPurposeBox" Style="{StaticResource ModernTextBox}"
                             PlaceholderText="Ремонт, авто, образование..." Margin="0,0,0,24"/>

                    <Border x:Name="ApplyErrBorder" Background="#2D1515" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="ApplyErrText" Foreground="{StaticResource DangerBrush}"
                                   FontFamily="Segoe UI" FontSize="13"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Оформить" Style="{StaticResource PrimaryButton}"
                                Padding="24,12" Click="ExecuteApply"/>
                        <Button Content="Отмена" Style="{StaticResource GhostButton}"
                                Padding="20,12" Margin="8,0,0,0" Click="HideApplyForm"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
