<Page x:Class="NexesPass.Views.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Аналитика расходов" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="PeriodText" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="Segoe UI" Margin="0,0,0,24"/>

            <!-- Summary cards -->
            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="22,18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Доходы за месяц" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="IncomeText" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="22,18" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Расходы за месяц" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="ExpenseText" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" FontFamily="Segoe UI"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="22,18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Баланс за месяц" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="NetText" FontSize="24" FontWeight="Bold"
                                   FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Spending chart (bar) -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Расходы по месяцам" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,20"/>

                    <!-- Simple bar chart -->
                    <Grid Height="200" x:Name="BarChartGrid">
                        <ItemsControl x:Name="BarChart">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                        <Border CornerRadius="6,6,0,0" VerticalAlignment="Bottom"
                                                Height="{Binding BarHeight}" HorizontalAlignment="Center" Width="32">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#6C63FF" Offset="0"/>
                                                    <GradientStop Color="#4ECDC4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding AmountLabel}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Category breakdown -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="По категориям" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="13"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} ₽}"
                                                           HorizontalAlignment="Right" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontFamily="Segoe UI"/>
                                            </Grid>
                                            <!-- Progress bar -->
                                            <Grid Margin="0,6,0,0" Height="4">
                                                <Border Background="{StaticResource InputBrush}" CornerRadius="2"/>
                                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}" Background="{StaticResource PrimaryBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoCategoryText" Text="Нет данных за текущий месяц"
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Segoe UI" HorizontalAlignment="Center"
                                   Margin="0,16" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Статистика" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" Margin="0,0,0,16"/>

                        <Border Background="{StaticResource InputBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Всего транзакций" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="TxCountText" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource InputBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Средний расход" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="AvgExpenseText" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource InputBrush}" CornerRadius="10" Padding="14,12">
                            <Grid>
                                <TextBlock Text="Крупнейший расход" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="MaxExpenseText" HorizontalAlignment="Right" FontSize="14"
                                           FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                                           FontFamily="Segoe UI"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource InputBrush}" CornerRadius="10" Padding="14,20" Margin="0,16,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💡" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Экономьте умнее" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Переводите 10% дохода на накопительный счёт каждый месяц"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
