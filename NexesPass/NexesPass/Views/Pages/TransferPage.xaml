<Page x:Class="NexesPass.Views.Pages.TransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Transfer form -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="32">
            <StackPanel MaxWidth="500">
                <TextBlock Text="Перевод средств" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <TextBlock Text="Переводите деньги мгновенно между счетами и другим пользователям"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" Margin="0,0,0,28"/>

                <!-- Method selector -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ByAccountBtn" Content="По счёту"
                            Style="{StaticResource PrimaryButton}" Click="SelectByAccount"
                            Padding="16,10" FontSize="13"/>
                    <Button x:Name="ByPhoneBtn" Grid.Column="2" Content="По телефону"
                            Style="{StaticResource GhostButton}" Click="SelectByPhone"
                            Padding="16,10" FontSize="13"/>
                </Grid>

                <!-- From account -->
                <TextBlock Text="СЧЁТ СПИСАНИЯ" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="FromAccountBox" Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,20" SelectionChanged="FromAccountChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Баланс: {0:N2} {1}">
                                            <Binding Path="Balance"/>
                                            <Binding Path="Currency"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Available balance hint -->
                <Border Background="{StaticResource InputBrush}" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Доступно:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="AvailableText" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="Segoe UI" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Recipient field -->
                <TextBlock x:Name="RecipientLabel" Text="СЧЁТ ПОЛУЧАТЕЛЯ" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="RecipientBox" Style="{StaticResource ModernTextBox}"
                         PlaceholderText="Номер счёта получателя" Margin="0,0,0,20"/>

                <!-- Amount -->
                <TextBlock Text="СУММА ПЕРЕВОДА" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,0,0,16">
                    <TextBox x:Name="AmountBox" Style="{StaticResource ModernTextBox}"
                             Text="0" Padding="16,12,60,12"/>
                    <TextBlock x:Name="CurrencySymbol" Text="₽" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,18,0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Quick amounts -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="1 000" Style="{StaticResource GhostButton}" Padding="14,6"
                            FontSize="12" Margin="0,0,6,0" Click="QuickAmount" Tag="1000"/>
                    <Button Content="5 000" Style="{StaticResource GhostButton}" Padding="14,6"
                            FontSize="12" Margin="0,0,6,0" Click="QuickAmount" Tag="5000"/>
                    <Button Content="10 000" Style="{StaticResource GhostButton}" Padding="14,6"
                            FontSize="12" Margin="0,0,6,0" Click="QuickAmount" Tag="10000"/>
                    <Button Content="50 000" Style="{StaticResource GhostButton}" Padding="14,6"
                            FontSize="12" Click="QuickAmount" Tag="50000"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Text="НАЗНАЧЕНИЕ ПЛАТЕЖА" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBox}"
                         PlaceholderText="За что перевод (необязательно)" Margin="0,0,0,24"/>

                <!-- Fee info -->
                <Border Background="{StaticResource InputBrush}" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Переводы между своими счетами — бесплатно. Другим пользователям — 0.5%"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Error/Success -->
                <Border x:Name="ErrBorder" Background="#2D1515" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="ErrText" Foreground="{StaticResource DangerBrush}"
                               FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="SuccBorder" Background="#152D1A" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="SuccText" Foreground="{StaticResource SuccessBrush}"
                               FontFamily="Segoe UI" FontSize="13"/>
                </Border>

                <Button x:Name="TransferBtn" Content="Перевести" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Padding="0,14" Click="ExecuteTransfer"/>
            </StackPanel>
        </Border>

        <!-- Right: Exchange rates + tips -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <!-- Exchange rates -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Курсы валют" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBlock Text="Обновлено сегодня" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇺🇸" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="USD / RUB" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="91.50" HorizontalAlignment="Right" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇪🇺" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="EUR / RUB" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="99.80" HorizontalAlignment="Right" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇬🇧" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="GBP / RUB" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="116.30" HorizontalAlignment="Right" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tips -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="💡 Советы" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI" Margin="0,0,0,16"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" LineHeight="20">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}">По номеру телефона</Run>
                        <Run Text=" — получатель должен быть зарегистрирован в Nexes Pass."/>
                    </TextBlock>
                    <TextBlock Text="Переводы между собственными счетами всегда мгновенные и бесплатные."
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" LineHeight="20" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
