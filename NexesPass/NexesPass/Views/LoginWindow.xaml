<Window x:Class="NexesPass.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexes Pass" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Branding Panel -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D0D1A" Offset="0"/>
                        <GradientStop Color="#1A0A2E" Offset="0.5"/>
                        <GradientStop Color="#0A1628" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Decorative circles -->
                    <Ellipse Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-150,-100,0,0" Opacity="0.08">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6C63FF" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-80,-80" Opacity="0.08">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#4ECDC4" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" Margin="60">
                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,48">
                            <Border Width="52" Height="52" CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6C63FF" Offset="0"/>
                                        <GradientStop Color="#4ECDC4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="N" FontSize="26" FontWeight="Black"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nexes Pass" FontSize="24" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"
                                       Margin="14,0,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <TextBlock FontSize="38" FontWeight="Black" Foreground="White"
                                   FontFamily="Segoe UI" LineHeight="46" Margin="0,0,0,20">
                            <Run Text="Банк нового"/>
                            <LineBreak/>
                            <Run Foreground="#6C63FF" Text="поколения"/>
                        </TextBlock>

                        <TextBlock Text="Управляйте финансами, переводите деньги и открывайте счета — всё в одном приложении."
                                   FontSize="15" Foreground="#8A8A9A" FontFamily="Segoe UI"
                                   TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,48"/>

                        <!-- Features -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1A1A2E">
                                    <TextBlock Text="🔒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="Банковская безопасность" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"/>
                                    <TextBlock Text="256-bit шифрование данных" FontSize="12"
                                               Foreground="#8A8A9A" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1A1A2E">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="Мгновенные переводы" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"/>
                                    <TextBlock Text="24/7 без выходных" FontSize="12"
                                               Foreground="#8A8A9A" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1A1A2E">
                                    <TextBlock Text="💳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="Виртуальные карты" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Visa, Mastercard, МИР" FontSize="12"
                                               Foreground="#8A8A9A" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Login Form -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,16,16,0" Padding="40">
                <Grid>
                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,0,0,0">
                        <Button Content="─" Style="{StaticResource GhostButton}"
                                Width="32" Height="32" Padding="0"
                                Click="MinimizeClick" FontSize="12"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}"
                                Width="32" Height="32" Padding="0"
                                Click="CloseClick" FontSize="12" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Form Content -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SubtitleText" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" Margin="0,0,0,36"/>

                        <!-- Register fields -->
                        <StackPanel x:Name="RegisterFields" Visibility="Collapsed">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ИМЯ" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="FirstNameBox" Style="{StaticResource ModernTextBox}"
                                             PlaceholderText="Иван"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ФАМИЛИЯ" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="LastNameBox" Style="{StaticResource ModernTextBox}"
                                             PlaceholderText="Иванов"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="ТЕЛЕФОН" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="PhoneBox" Style="{StaticResource ModernTextBox}"
                                     PlaceholderText="+7 900 000-00-00" Margin="0,0,0,16"/>
                        </StackPanel>

                        <TextBlock Text="EMAIL" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}"
                                 PlaceholderText="your@email.com" Margin="0,0,0,16"/>

                        <TextBlock Text="ПАРОЛЬ" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                                     Margin="0,0,0,24"/>

                        <!-- Error/Success -->
                        <Border x:Name="ErrorBorder" Background="#2D1515" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                                       FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <Border x:Name="SuccessBorder" Background="#152D1A" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="SuccessText" Foreground="{StaticResource SuccessBrush}"
                                       FontFamily="Segoe UI" FontSize="13"/>
                        </Border>

                        <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}"
                                Click="SubmitClick" HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"/>

                        <Button x:Name="ToggleButton" Style="{StaticResource GhostButton}"
                                Click="ToggleClick" HorizontalAlignment="Stretch"/>

                        <!-- Demo hint -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                Padding="14,10" Margin="0,24,0,0">
                            <TextBlock FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="Демо:"/>
                                <Run Text=" Зарегистрируйтесь с любыми данными для начала работы"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drag region -->
            <Border Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top"
                    Background="Transparent" MouseLeftButtonDown="DragWindow"/>
        </Grid>
    </Border>
</Window>
